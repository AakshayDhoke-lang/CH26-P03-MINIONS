# FlowForge AI provider
# Use "nvidia" for NVIDIA-hosted NIM or "lmstudio" for a local OpenAI-compatible LM Studio server.
AI_PROVIDER=lmstudio

# NVIDIA NIM (optional online provider)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=google/gemma-4-31b-it
NVIDIA_API_KEY=nvapi-your-key-here
# Keep structured output off by default for maximum model/endpoint compatibility.
# FlowForge still requires JSON in the prompt and has adaptive JSON/DSL normalization.
NVIDIA_STRUCTURED_OUTPUT=off
NVIDIA_ENABLE_THINKING=false
NVIDIA_PLANNER_MAX_TOKENS=3200
NVIDIA_PLANNER_COMPLETION_MAX_TOKENS=1100

# Local LM Studio — primary/default planner for the v5 Understanding stage.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=auto
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_STRUCTURED_OUTPUT=auto

# Shared per-task output budgets. These control both NVIDIA NIM and LM Studio.
AI_PLANNER_MAX_TOKENS=1800
AI_PLANNER_COMPLETION_MAX_TOKENS=700
AI_VERIFIER_REVIEW_MAX_TOKENS=900
AI_VERIFIER_REPAIR_MAX_TOKENS=900
AI_VERIFIER_RETRY_MAX_TOKENS=650
AI_TEST_MAX_TOKENS=1000
AI_TEST_RETRY_MAX_TOKENS=700

# Judge-safe presentation mode (recommended for the hackathon demo).
# In the v5 Understanding stage, planning always tries the selected LLM first.
# This flag currently affects the later verification stage only; compiler templates are fallback-only.
FLOWFORGE_JUDGE_MODE=true
